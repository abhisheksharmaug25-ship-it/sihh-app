generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  PATIENT
  DOCTOR
}

enum DocumentCategory {
  PRESCRIPTION
  LAB_REPORT
  MEDICAL_REPORT
  OTHER
}

model Hospital {
  id        String   @id @default(cuid())
  name      String
  city      String?
  doctors   Doctor[]
  patients  Patient[]
  createdAt DateTime @default(now())
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole
  patient      Patient?
  doctor       Doctor?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Patient {
  id                 String                    @id @default(cuid())
  patientId          String                    @unique
  userId             String                    @unique
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId         String
  hospital           Hospital                  @relation(fields: [hospitalId], references: [id])
  fullName           String
  dateOfBirth        DateTime?
  gender             String?
  phone              String?
  bloodGroup         String?
  allergies          String?
  emergencyContact   String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  currentMedicines   String?
  majorConditions    String?
  histories          MedicalHistory[]
  documents          MedicalDocument[]
  consultations      Consultation[]
  prescriptions      Prescription[]
  aiSummaries        AiSummary[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

model Doctor {
  id           String          @id @default(cuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId   String
  hospital     Hospital        @relation(fields: [hospitalId], references: [id])
  fullName     String
  specialty    String
  clinicInfo   String?
  consultations Consultation[]
  createdAt    DateTime        @default(now())
}

model MedicalHistory {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?
  eventDate   DateTime?
  createdAt   DateTime @default(now())
}

model MedicalDocument {
  id                String           @id @default(cuid())
  patientId         String
  patient            Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category          DocumentCategory
  fileName          String
  fileUrl           String
  mimeType          String
  extractedData     Json?
  extractionStatus  String           @default("PENDING")
  createdAt         DateTime         @default(now())
}

model Consultation {
  id              String      @id @default(cuid())
  patientId       String
  patient         Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor      @relation(fields: [doctorId], references: [id])
  chiefComplaint  String
  clinicalNotes   String?
  assessment      String?
  treatmentNotes  String?
  followUpNotes   String?
  consultationDate DateTime   @default(now())
  prescriptions   Prescription[]
}

model Prescription {
  id             String        @id @default(cuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  medicineName   String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?
  createdAt      DateTime      @default(now())
}

model AiSummary {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  mainProblem      String?
  symptoms         String?
  duration         String?
  severity         String?
  otherSymptoms    String?
  existingConditions String?
  currentMedicines String?
  allergies        String?
  conversationJson Json?
  status           String   @default("COMPLETED")
  createdAt        DateTime @default(now())
}
